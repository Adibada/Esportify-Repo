# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
# APP_SECRET doit être défini dans .env.test.local (non versionné)
APP_SECRET=
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
APP_ENV=test
APP_DEBUG=1
# DATABASE_URL doit être défini dans .env.test.local (non versionné)
# Exemple : DATABASE_URL="mysql://user:password@127.0.0.1:3306/app_test?serverVersion=8.0"
DATABASE_URL=

